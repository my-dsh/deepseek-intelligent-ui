root = Col([head, meta, body, quote, links, steps, snippet, notes], 3)
head = Col([Title("Quarterly business review", "xl"), Caption("Prepared for the leadership team")], 1)
meta = Row([Label("Status"), Badge("On track", "success"), Badge("Watchlist", "warning"), Spacer(), Link("Full report", "https://example.com/report")], 2, "center")
body = Text("Revenue grew 18% quarter over quarter, led by EMEA. Churn held flat while average contract value rose.", "md")
quote = Quote("We ship when it is ready, not when the calendar says so.", "Engineering")
links = List(["Summary deck", "Raw numbers", "Method notes"], "bullet")
steps = List([step1, step2], "numbered")
step1 = ListItem("Collect the data", "Pull the warehouse snapshot", "check")
step2 = ListItem("Review with finance", "Reconcile the adjustments", "check")
snippet = Code("SELECT region, sum(amount) AS revenue FROM sales GROUP BY region ORDER BY revenue DESC", "sql")
notes = Text("Figures are unaudited.", "xs", "muted")
