root = Form([heading, nameField, notes, picker, mode, slider, agree, choice, when, timer, press, actions, summary])
$name = ""
$notes = ""
$region = "emea"
$mode = "monthly"
$volume = 40
$agree = false
$plan = "pro"
$when = "2026-01-15"
heading = Row([Title("New subscription", "lg"), Spacer(), Badge("Inputs", "info")], 2)
nameField = Input($name, "Account name", "text", "Acme Inc.")
notes = TextArea($notes, "Internal notes", "Anything the team should know", 4)
picker = Select($region, [{value: "emea", label: "EMEA"}, {value: "apac", label: "APAC"}, {value: "amer", label: "AMER"}], "Region", "Choose a region")
mode = SegmentedControl($mode, ["monthly", "annual"], false)
slider = Slider($volume, 10, 500, 10, "Seats", " seats", [10, 100, 250, 500])
agree = Checkbox($agree, "I accept the terms", false)
choice = RadioGroup($plan, [{value: "starter", label: "Starter"}, {value: "pro", label: "Pro"}, {value: "enterprise", label: "Enterprise"}], "Plan", "cards")
when = DatePicker($when, "Start date", "2026-01-01", "2026-12-31")
timer = Timer(120, "Onboarding call")
press = Pressable([Text("Pressable row", "sm")], null, false, 2, "surface", "md")
actions = Row([Button("Save", Action([@Set($name, @Upper($name))]), "solid", "primary", "md", "check", false, false), IconButton("trash-2", @Reset(), "Discard", "ghost")], 2)
summary = Text($name + " / " + $region + " / " + $mode, "sm", "muted")
